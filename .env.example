# Optional Docker Compose overrides.
# Copy to .env before `docker compose up --build` if you want custom values.

# Development-only signing secret. Replace with a long random value before
# exposing this stack outside your machine. Never commit the real .env file.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Demo seed accounts (created by `docker compose exec backend npm run seed`).
SEED_ADMIN_EMAIL=admin@payshield.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_PASSWORD=Customer@123

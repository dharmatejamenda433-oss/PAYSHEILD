# Server
PORT=5000
NODE_ENV=development

# MongoDB. Transactions require a replica set.
# Local replica set:
MONGODB_URI=mongodb://127.0.0.1:27017/payshield?replicaSet=rs0
# MongoDB Atlas instead (copy the Node.js driver string from Atlas):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/payshield?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=1d

# Redis (velocity counters, rate limiting, idempotency cache).
# Start the Docker image with: docker compose up -d redis
# It publishes localhost:6379, matching the URL below.
# If Redis is unreachable the API degrades to an in-process store and logs a warning.
REDIS_URL=redis://127.0.0.1:6379

# Python FastAPI fraud service
FRAUD_SERVICE_URL=http://127.0.0.1:8000
FRAUD_SERVICE_TIMEOUT_MS=2500

# Frontend origin allowed by CORS / Socket.IO
FRONTEND_URL=http://localhost:5173

# Simulated wallets (integer minor units: 1 INR = 100 paise)
STARTING_BALANCE_PAISE=5000000

# Risk policy
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=70
# review = HIGH risk goes to admin review, decline = HIGH risk is declined automatically
HIGH_RISK_ACTION=review
ML_WEIGHT=0.6
RULE_WEIGHT=0.4
LARGE_AMOUNT_THRESHOLD_PAISE=2500000

# Idempotency cache TTL (MongoDB remains the durable source of truth)
IDEMPOTENCY_TTL_SECONDS=86400

# Demo seed script (development only — change before using publicly)
SEED_ADMIN_EMAIL=admin@payshield.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_PASSWORD=Customer@123
